%%{init: {"theme": "base", "themeVariables": {"fontFamily": "\"Times New Roman\", SimSun, \"Songti SC\", STSong, serif"}, "themeCSS": "text, .nodeLabel, .edgeLabel, .label, .actor, .messageText, .loopText, .noteText, .titleText { font-family: \"Times New Roman\", SimSun, \"Songti SC\", STSong, serif !important; }"}}%%
flowchart TB
    user["用户 / 浏览器"]

    subgraph frontend["前端 Web 应用 (React + TypeScript + Vite)"]
        ui["文件管理、分享、检索、协同编辑界面"]
        crypto["Web Crypto API<br/>AES-GCM / RSA-OAEP / PBKDF2"]
        localdb["IndexedDB<br/>本地密文向量索引"]
    end

    subgraph access["接入层 (rustcloud-api)"]
        rest["REST API<br/>Axum Handler"]
        ws["WebSocket Endpoint<br/>协同编辑通道"]
        middleware["JWT 认证 / CORS / 限流 / 请求校验"]
    end

    subgraph business["业务层 Cargo Workspace"]
        auth["rustcloud-auth<br/>JWT 与会话管理"]
        crypto_srv["rustcloud-crypto<br/>Argon2id / SHA-256"]
        database["rustcloud-database<br/>SeaORM Entity / Repository"]
        storage["rustcloud-storage<br/>Storage trait"]
        core["rustcloud-core<br/>配置、错误、工具类型"]
    end

    subgraph data["数据层"]
        pg["PostgreSQL<br/>用户、元信息、密钥密文、分享记录"]
        redis["Redis<br/>会话白名单、黑名单、限流状态"]
        minio["MinIO / S3<br/>文件密文对象"]
    end

    user --> ui
    ui --> crypto
    crypto -->|"生成密文、密文密钥"| rest
    ui -->|"JWT + HTTPS"| rest
    ui -->|"JWT query + E2EE message"| ws
    crypto --> localdb

    rest --> middleware
    ws --> middleware
    middleware --> auth
    middleware --> database
    rest --> storage
    rest --> crypto_srv
    rest --> core

    auth --> redis
    database --> pg
    storage --> minio
    crypto_srv --> pg

    classDef client fill:#e8f4ff,stroke:#2563eb,color:#0f172a;
    classDef server fill:#ecfdf3,stroke:#16a34a,color:#0f172a;
    classDef data fill:#fff7ed,stroke:#ea580c,color:#0f172a;
    class frontend,user client;
    class access,business server;
    class data data;

