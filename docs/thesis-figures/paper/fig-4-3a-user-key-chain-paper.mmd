flowchart LR
    password["用户口令<br/>仅用户输入时出现"]
    salt["PBKDF2 salt<br/>后端保存"]
    kek["KEK<br/>浏览器端派生"]
    rsa_priv["RSA 私钥明文<br/>仅浏览器内存"]
    enc_priv["encrypted_private_key<br/>后端保存"]

    password -->|"PBKDF2-HMAC-SHA-256"| kek
    salt -->|"参与派生"| kek
    kek -->|"AES-GCM 解密"| rsa_priv
    rsa_priv -.->|"AES-GCM 加密后持久化"| enc_priv

    classDef local fill:#e8f4ff,stroke:#2563eb,color:#0f172a;
    classDef server fill:#fff7ed,stroke:#ea580c,color:#0f172a;
    class password,kek,rsa_priv local;
    class salt,enc_priv server;

