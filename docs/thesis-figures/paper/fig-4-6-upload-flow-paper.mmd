%%{init: {"theme": "base", "themeVariables": {"fontFamily": "\"Times New Roman\", SimSun, \"Songti SC\", STSong, serif", "fontSize": "20px"}, "flowchart": {"htmlLabels": true, "nodeSpacing": 60, "rankSpacing": 80}, "sequence": {"actorFontSize": 18, "messageFontSize": 18, "noteFontSize": 18}, "themeCSS": "text, .nodeLabel, .edgeLabel, .label, .actor, .messageText, .loopText, .noteText, .titleText { font-family: \"Times New Roman\", SimSun, \"Songti SC\", STSong, serif !important; font-size: 20px !important; } .edgeLabel text, .edgeLabel span, .messageText, .actor { font-size: 18px !important; } .node rect, .node polygon, .node circle, .node ellipse { stroke-width: 2px !important; } .flowchart-link, .messageLine0, .messageLine1 { stroke-width: 2.4px !important; }"}}%%
flowchart LR
    file["本地文件<br/>明文内容 + 文件名"]
    gen["生成随机 DEK<br/>256 bit"]
    aes_content["AES-GCM 加密文件内容<br/>content_nonce"]
    aes_name["AES-GCM 加密文件名<br/>name_nonce"]
    wrap["RSA-OAEP 使用用户公钥包装 DEK"]
    api["POST /api/v1/documents<br/>multipart 密文 + 元数据"]
    minio["MinIO<br/>保存文件密文对象"]
    db_doc["documents<br/>保存 encrypted_name、nonce、storage_path"]
    db_key["document_keys<br/>保存 encrypted_key 与权限"]

    file --> gen
    gen --> aes_content
    gen --> aes_name
    gen --> wrap
    aes_content --> api
    aes_name --> api
    wrap --> api
    api --> minio
    api --> db_doc
    api --> db_key

    classDef local fill:#e8f4ff,stroke:#2563eb,color:#0f172a;
    classDef server fill:#fff7ed,stroke:#ea580c,color:#0f172a;
    class file,gen,aes_content,aes_name,wrap local;
    class api,minio,db_doc,db_key server;

