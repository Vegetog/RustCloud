flowchart LR
    rsa_pub["RSA 公钥<br/>后端保存"]
    rsa_priv["RSA 私钥明文<br/>浏览器内存"]
    dek["DEK<br/>每文件随机生成"]
    enc_dek["encrypted_key<br/>document_keys 保存"]
    plaintext["文件明文 / 文件名明文<br/>仅浏览器端"]
    ciphertext["文件密文 / 加密文件名<br/>数据库 + MinIO 保存"]

    rsa_pub -->|"RSA-OAEP 包装 DEK"| enc_dek
    enc_dek -->|"下载时取回"| dek
    rsa_priv -->|"RSA-OAEP 解包"| dek
    plaintext -->|"AES-GCM 上传前加密"| ciphertext
    dek -->|"AES-GCM 加解密"| ciphertext
    ciphertext -->|"下载后本地解密"| plaintext

    classDef local fill:#e8f4ff,stroke:#2563eb,color:#0f172a;
    classDef server fill:#fff7ed,stroke:#ea580c,color:#0f172a;
    class rsa_priv,dek,plaintext local;
    class rsa_pub,enc_dek,ciphertext server;

