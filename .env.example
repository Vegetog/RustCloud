# RustCloud 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===================
# 数据库配置
# ===================
POSTGRES_USER=rustcloud
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rustcloud

# ===================
# Redis 配置
# ===================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===================
# MinIO / 对象存储配置
# ===================
MINIO_ROOT_USER=rustcloud-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STORAGE_BUCKET=rustcloud

# ===================
# JWT 配置
# ===================
# 生产环境请用: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# ===================
# Argon2 配置
# ===================
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ===================
# 日志配置
# ===================
RUST_LOG=rustcloud=info

# ===================
# 服务配置
# ===================
PUBLIC_PORT=80

# ===================
# 镜像配置
# ===================
IMAGE_OWNER=your-github-username
IMAGE_TAG=latest
