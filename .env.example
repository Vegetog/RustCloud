# RustCloud Environment Configuration
# Copy this file to .env and modify as needed

# ===================
# Server Configuration
# ===================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===================
# Database Configuration
# ===================
DATABASE_URL=postgres://rustcloud:rustcloud_dev@localhost:5432/rustcloud
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# ===================
# Redis Configuration
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Storage Configuration
# ===================
# Backend: local or minio
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=rustcloud
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ===================
# JWT Configuration
# ===================
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=your-super-secret-key-at-least-32-bytes-long-change-in-production
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# ===================
# Argon2 Configuration
# ===================
# Memory in KB (65536 = 64MB)
ARGON2_MEMORY=65536
# Number of iterations
ARGON2_ITERATIONS=3
# Parallelism (number of threads)
ARGON2_PARALLELISM=4

# ===================
# Logging Configuration
# ===================
RUST_LOG=rustcloud=debug,tower_http=debug
