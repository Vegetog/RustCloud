# RustCloud Production Environment
# Copy to .env.prod and fill in actual values

# Database
POSTGRES_USER=rustcloud
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rustcloud

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO / Object Storage
MINIO_ROOT_USER=rustcloud-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STORAGE_BUCKET=rustcloud

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# Argon2
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# Logging
RUST_LOG=rustcloud=info

# Public port
PUBLIC_PORT=80

IMAGE_TAG=v1.0.5
IMAGE_OWNER=Vegetog
