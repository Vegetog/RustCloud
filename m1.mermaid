graph TD
    %% 样式定义
    classDef browser fill:#f9f,stroke:#333,stroke-width:2px;
    classDef rust fill:#dea,stroke:#333,stroke-width:2px;
    classDef db fill:#add,stroke:#333,stroke-width:2px;
    classDef infra fill:#eee,stroke:#333,stroke-width:1px,stroke-dasharray: 5 5;

    subgraph User_Machine [用户本地机器 / 浏览器]
        Browser[("Browser (Chrome/Edge)")]:::browser
    end

    subgraph Docker_Network [Docker Network: rustcloud_default]
        direction TB

        subgraph Frontend_Container [Frontend Node/Vite]
            Web[("rustcloud-web<br/>Port: 3000")]:::rust
            ViteProxy["Vite Proxy<br/>(转发 /api 请求)"]
        end

        subgraph Backend_Group [Backend Services]
            API[("rustcloud-api<br/>Port: 8080")]:::rust
            Migration[("rustcloud-migration<br/>(启动时运行一次)")]:::rust
        end

        subgraph Data_Layer [Infrastructure]
            PG[("Postgres DB<br/>Port: 5432")]:::db
            Redis[("Redis Cache<br/>Port: 6379")]:::db
            MinIO[("MinIO Object Storage<br/>Port: 9000/9001")]:::db
        end
        
        Adminer[("Adminer<br/>Port: 8081")]:::infra
    end

    %% 连线关系
    Browser -- "HTTP :3000 (UI)" --> Web
    Browser -- "HTTP :8080 (Direct API)" --> API
    Browser -- "HTTP :9001 (MinIO Console)" --> MinIO
    Browser -- "HTTP :8081 (DB Admin)" --> Adminer

    %% 前端内部转发
    Web -- "Internal Request" --> ViteProxy
    ViteProxy -.-> API

    %% 后端依赖
    API -- "SQLx / SeaORM" --> PG
    API -- "redis crate" --> Redis
    API -- "aws-sdk-s3" --> MinIO
    Migration -- "Run Migrations" --> PG

    %% Adminer
    Adminer -.-> PG

    %% 对应文件说明
    note_compose[Based on: docker-compose.dev.yml]
    note_compose -.- Docker_Network