POSTGRES_PASSWORD=rustcloud_dev
POSTGRES_DB=rustcloud

# ===================
# Redis 配置
# ===================
REDIS_PASSWORD=redis_dev_pass

# ===================
# MinIO / 对象存储配置
# ===================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
STORAGE_BUCKET=rustcloud

# ===================
# JWT 配置
# ===================
