# RustCloud 环境变量配置

# ===================
# 服务器配置
# ===================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===================
# 数据库配置
# ===================
DATABASE_URL=postgres://rustcloud:rustcloud_dev@localhost:5432/rustcloud
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# ===================
# Redis 配置
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# 存储配置
# ===================
# 存储后端：local 或 minio
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=rustcloud
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ===================
# JWT 配置
# ===================
JWT_SECRET=U639NbSXHJkN3x5oYDmE96hR8YnqupytquR0Q/gBN4CKeSmlgsmJ5V2Mb+pBpair
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# ===================
# Argon2 配置
# ===================
# 内存大小（KB，65536 = 64MB）
ARGON2_MEMORY=65536
# 迭代次数
ARGON2_ITERATIONS=3
# 并行度（线程数）
ARGON2_PARALLELISM=4

# ===================
# 日志配置
# ===================
RUST_LOG=rustcloud=debug,tower_http=debug
